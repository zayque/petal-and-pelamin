// Petal & Pelamin — data model
// Replaces the legacy tables: register / tblusers / tb_member (→ User),
// tblservice / tblproduct (→ Service), tblbookingdetail (→ CartItem / BookingItem),
// tblbooking (→ Booking), unavailabledate / temp_unavailable (→ BlockedDate + bookings),
// messages (→ Message).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Category {
  HALL
  PACKAGE
  DAIS
  DRESS
  PHOTOBOOTH
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(190)
  phone        String?    @db.VarChar(30)
  passwordHash String     @db.VarChar(100)
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cartItems    CartItem[]
  bookings     Booking[]
}

model Service {
  id          Int           @id @default(autoincrement())
  slug        String        @unique @db.VarChar(160)
  name        String        @db.VarChar(160)
  category    Category
  tagline     String        @db.VarChar(255)
  description String        @db.Text
  /// JSON array of strings — what's included
  features    Json
  price       Decimal       @db.Decimal(10, 2)
  /// "per event", "per day", "per set"…
  priceUnit   String        @default("per event") @db.VarChar(40)
  capacity    Int?
  location    String?       @db.VarChar(160)
  imageUrl    String        @db.VarChar(255)
  /// JSON array of extra image paths
  gallery     Json
  isFeatured  Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cartItems   CartItem[]
  bookingItems BookingItem[]
  blockedDates BlockedDate[]

  @@index([category, isActive])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  serviceId Int
  eventDate DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId, eventDate])
}

model Booking {
  id            Int           @id @default(autoincrement())
  code          String        @unique @db.VarChar(20)
  userId        Int
  status        BookingStatus @default(PENDING_PAYMENT)
  contactName   String        @db.VarChar(120)
  contactEmail  String        @db.VarChar(190)
  contactPhone  String        @db.VarChar(30)
  address       String        @db.VarChar(255)
  city          String        @db.VarChar(80)
  state         String        @db.VarChar(80)
  notes         String?       @db.Text
  subtotal      Decimal       @db.Decimal(10, 2)
  deposit       Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod String?       @db.VarChar(40)
  paymentRef    String?       @db.VarChar(60)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         BookingItem[]

  @@index([status])
}

model BookingItem {
  id        Int      @id @default(autoincrement())
  bookingId Int
  serviceId Int
  name      String   @db.VarChar(160)
  category  Category
  eventDate DateTime @db.Date
  price     Decimal  @db.Decimal(10, 2)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, eventDate])
}

/// Dates an admin has closed off — for one service, or for everything when serviceId is null.
model BlockedDate {
  id        Int      @id @default(autoincrement())
  serviceId Int?
  date      DateTime @db.Date
  reason    String?  @db.VarChar(160)
  createdAt DateTime @default(now())
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([date])
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(190)
  phone     String?  @db.VarChar(30)
  eventDate DateTime? @db.Date
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
