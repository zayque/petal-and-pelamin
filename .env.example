# --- Database (MySQL runs in Docker, see docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=rootpetal
MYSQL_DATABASE=petal_pelamin
MYSQL_USER=petal
MYSQL_PASSWORD=petalpass
MYSQL_PORT=3307

# Used by Prisma when running the app on your host machine (npm run dev).
# Inside docker compose the app container overrides this to use host "db".
DATABASE_URL="mysql://petal:petalpass@localhost:3307/petal_pelamin"

# --- Auth ---
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Seeded admin account ---
ADMIN_EMAIL=admin@petalpelamin.my
ADMIN_PASSWORD=Admin@12345
